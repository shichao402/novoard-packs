{
  "id": "versionControl",
  "displayName": "版本控制",
  "schemaVersion": 1,
  "runtime": "node",
  "entry": "dist/pack.mjs",
  "tools": [
    {
      "id": "svn-update",
      "displayName": "SVN 更新",
      "description": "对照远端差异估计将写入的文件；Windows 上可按写集释放占用后再更新",
      "idempotent": true,
      "requiresExclusiveWorkspace": true,
      "supportsDryRun": true,
      "params": [
        {
          "name": "strategy",
          "type": "enum",
          "enum": [
            "follow-latest",
            "manual",
            "disabled"
          ],
          "default": "follow-latest",
          "required": true,
          "label": "更新策略"
        },
        {
          "name": "onConflict",
          "type": "enum",
          "enum": [
            "fail",
            "postpone",
            "revert"
          ],
          "default": "fail",
          "label": "遇到冲突",
          "description": "fail: 冲突即失败；postpone: 保留现场挂起本轮，下轮自动继续；revert: 备份后还原"
        },
        {
          "name": "backupOnRevert",
          "type": "boolean",
          "default": true,
          "label": "还原前备份"
        },
        {
          "name": "backupDir",
          "type": "string",
          "label": "备份目录",
          "format": "path"
        },
        {
          "name": "releaseOccupants",
          "type": "boolean",
          "default": true,
          "label": "释放占用",
          "description": "按本次将写入的文件释放占用；独占失败会 cleanup 后重试一次。不想强杀就关掉"
        }
      ]
    },
    {
      "id": "svn-cleanup",
      "displayName": "SVN Cleanup",
      "idempotent": true,
      "requiresExclusiveWorkspace": true,
      "params": [
        {
          "name": "removeUnversioned",
          "type": "boolean",
          "default": false,
          "label": "删除未纳管文件"
        }
      ]
    },
    {
      "id": "svn-revert",
      "displayName": "SVN Revert",
      "description": "按 svn status 的本地改动估计将改写的文件；Windows 上可先释放占用",
      "idempotent": true,
      "requiresExclusiveWorkspace": true,
      "params": [
        {
          "name": "recursive",
          "type": "boolean",
          "default": true,
          "label": "递归"
        },
        {
          "name": "releaseOccupants",
          "type": "boolean",
          "default": true,
          "label": "释放占用",
          "description": "按本地脏文件释放占用。不想强杀就关掉"
        }
      ]
    },
    {
      "id": "svn-switch",
      "displayName": "SVN Switch",
      "idempotent": false,
      "requiresExclusiveWorkspace": true,
      "remoteWrite": false,
      "params": [
        {
          "name": "url",
          "type": "string",
          "required": true,
          "label": "目标 URL"
        }
      ]
    },
    {
      "id": "svn-copy",
      "displayName": "SVN Copy（远端写）",
      "idempotent": false,
      "remoteWrite": true,
      "params": [
        {
          "name": "source",
          "type": "string",
          "required": true,
          "label": "源 URL"
        },
        {
          "name": "destination",
          "type": "string",
          "required": true,
          "label": "目标 URL"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "label": "提交说明"
        }
      ]
    },
    {
      "id": "svn-delete",
      "displayName": "SVN Delete（远端写）",
      "idempotent": false,
      "remoteWrite": true,
      "params": [
        {
          "name": "target",
          "type": "string",
          "required": true,
          "label": "要删除的 URL"
        },
        {
          "name": "message",
          "type": "string",
          "required": true,
          "label": "提交说明"
        }
      ]
    },
    {
      "id": "git-status",
      "displayName": "Git Status",
      "description": "查看工作区与分支状态",
      "idempotent": true,
      "supportsDryRun": true,
      "params": []
    },
    {
      "id": "git-fetch",
      "displayName": "Git Fetch",
      "description": "拉取远端引用，不合并",
      "idempotent": true,
      "supportsDryRun": true,
      "params": [
        {
          "name": "remote",
          "type": "string",
          "label": "远端",
          "description": "远端名；留空则 --all"
        },
        {
          "name": "prune",
          "type": "boolean",
          "default": true,
          "label": "清理失效分支",
          "description": "删除远端已不存在的跟踪分支"
        }
      ]
    },
    {
      "id": "git-pull",
      "displayName": "Git Pull",
      "description": "拉取并更新当前分支（对应 SVN 更新）",
      "idempotent": true,
      "requiresExclusiveWorkspace": true,
      "supportsDryRun": true,
      "params": [
        {
          "name": "strategy",
          "type": "enum",
          "enum": [
            "follow-latest",
            "manual",
            "disabled"
          ],
          "default": "follow-latest",
          "required": true,
          "label": "更新策略",
          "description": "follow-latest 每次拉取；manual 仅手动触发；disabled 跳过"
        },
        {
          "name": "remote",
          "type": "string",
          "label": "远端",
          "description": "远端名，默认 origin（指定 branch 时）"
        },
        {
          "name": "branch",
          "type": "string",
          "label": "分支",
          "description": "分支名；留空则拉当前分支的上游"
        },
        {
          "name": "ffOnly",
          "type": "boolean",
          "default": true,
          "label": "仅快进",
          "description": "仅快进，避免自动合并提交"
        },
        {
          "name": "rebase",
          "type": "boolean",
          "default": false,
          "label": "用 rebase 合并"
        }
      ]
    },
    {
      "id": "git-checkout",
      "displayName": "Git Checkout",
      "description": "切换分支或检出指定引用",
      "idempotent": false,
      "requiresExclusiveWorkspace": true,
      "params": [
        {
          "name": "ref",
          "type": "string",
          "required": true,
          "label": "引用",
          "description": "分支、tag 或 commit"
        },
        {
          "name": "create",
          "type": "boolean",
          "default": false,
          "label": "不存在则新建",
          "description": "不存在则新建分支（-b）"
        }
      ]
    },
    {
      "id": "git-stash",
      "displayName": "Git Stash",
      "description": "暂存或恢复本地改动",
      "idempotent": false,
      "requiresExclusiveWorkspace": true,
      "params": [
        {
          "name": "action",
          "type": "enum",
          "enum": [
            "push",
            "pop",
            "drop",
            "list"
          ],
          "default": "push",
          "required": true,
          "label": "操作"
        },
        {
          "name": "message",
          "type": "string",
          "label": "说明",
          "description": "push 时的说明"
        },
        {
          "name": "includeUntracked",
          "type": "boolean",
          "default": false,
          "label": "包含未跟踪文件",
          "description": "push 时包含未跟踪文件"
        }
      ]
    },
    {
      "id": "git-clean",
      "displayName": "Git Clean",
      "description": "删除未跟踪文件",
      "idempotent": true,
      "requiresExclusiveWorkspace": true,
      "params": [
        {
          "name": "directories",
          "type": "boolean",
          "default": true,
          "label": "删除未跟踪目录",
          "description": "同时删除未跟踪目录（-d）"
        },
        {
          "name": "ignored",
          "type": "boolean",
          "default": false,
          "label": "删除被忽略的文件",
          "description": "同时删除被 ignore 的文件（-x）"
        }
      ]
    },
    {
      "id": "git-reset",
      "displayName": "Git Reset",
      "description": "重置 HEAD / 暂存区 / 工作区",
      "idempotent": false,
      "requiresExclusiveWorkspace": true,
      "params": [
        {
          "name": "mode",
          "type": "enum",
          "enum": [
            "mixed",
            "hard"
          ],
          "default": "mixed",
          "required": true,
          "label": "模式",
          "description": "mixed 保留工作区改动；hard 丢弃本地改动"
        },
        {
          "name": "ref",
          "type": "string",
          "default": "HEAD",
          "label": "引用",
          "description": "重置到的引用"
        }
      ]
    },
    {
      "id": "git-commit",
      "displayName": "Git Commit",
      "description": "提交本地改动",
      "idempotent": false,
      "requiresExclusiveWorkspace": true,
      "params": [
        {
          "name": "message",
          "type": "string",
          "required": true,
          "label": "提交说明"
        },
        {
          "name": "all",
          "type": "boolean",
          "default": true,
          "label": "提交全部改动",
          "description": "提交前 git add -A"
        },
        {
          "name": "allowEmpty",
          "type": "boolean",
          "default": false,
          "label": "允许空提交"
        }
      ]
    },
    {
      "id": "git-push",
      "displayName": "Git Push（远端写）",
      "description": "推送到远端",
      "idempotent": false,
      "remoteWrite": true,
      "requiresExclusiveWorkspace": true,
      "params": [
        {
          "name": "remote",
          "type": "string",
          "default": "origin",
          "label": "远端"
        },
        {
          "name": "ref",
          "type": "string",
          "label": "引用",
          "description": "要推送的引用；留空则推当前分支"
        },
        {
          "name": "setUpstream",
          "type": "boolean",
          "default": false,
          "label": "设置上游"
        },
        {
          "name": "force",
          "type": "boolean",
          "default": false,
          "label": "强制推送",
          "description": "使用 --force-with-lease，避免覆盖未知远端提交"
        }
      ]
    }
  ]
}
