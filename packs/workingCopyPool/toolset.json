{
  "id": "workingCopyPool",
  "displayName": "工作副本池",
  "schemaVersion": 1,
  "runtime": "node",
  "entry": "dist/pack.mjs",
  "tools": [
    {
      "id": "candidates",
      "displayName": "候选分支",
      "description": "开分支的候选项：池中已有、工程清单（projects）、最近使用、listFrom 下最近有提交的分支",
      "kind": "query",
      "idempotent": true,
      "supportsDryRun": true,
      "supportsResultJson": true
    },
    {
      "id": "occupied",
      "displayName": "占用中的分支",
      "description": "释放分支的候选项：当前有有效租约的分支",
      "kind": "query",
      "idempotent": true,
      "supportsDryRun": true,
      "supportsResultJson": true
    },
    {
      "id": "status",
      "displayName": "池状态",
      "description": "每个槽位的分支、状态、租约、标签、本地改动、落后 revision、最后使用时间与实际存放路径",
      "kind": "query",
      "idempotent": true,
      "supportsDryRun": true,
      "supportsResultJson": true
    },
    {
      "id": "acquire",
      "displayName": "占用分支",
      "description": "按分支占用一个工作副本，入口固定为 <池根>/branch/<分支>",
      "kind": "action",
      "idempotent": true,
      "supportsDryRun": true,
      "supportsResultJson": true,
      "params": [
        {
          "name": "branch",
          "type": "string",
          "required": true,
          "label": "分支"
        },
        {
          "name": "ttl",
          "type": "string",
          "label": "保留时长",
          "description": "如 1d、3d、12h 或 forever；缺省取 pool.toml 的 defaultTtl"
        },
        {
          "name": "tag",
          "type": "string",
          "label": "标签",
          "description": "如 bug-12345，池满时会列出"
        }
      ]
    },
    {
      "id": "release",
      "displayName": "释放分支",
      "description": "清除租约，不动文件；下次再要这个分支时不用切换",
      "kind": "action",
      "idempotent": true,
      "supportsDryRun": true,
      "supportsResultJson": true,
      "params": [
        {
          "name": "branch",
          "type": "string",
          "required": true,
          "label": "分支"
        }
      ]
    },
    {
      "id": "hold",
      "displayName": "保护工作副本",
      "description": "外部应用正在使用该分支的工作副本时加保护：不随租约到期或进程退出失效，切换、缩容、refresh 更新都会跳过；只能用同一 holdId 的 unhold 解除，多个持有者互不影响",
      "kind": "action",
      "idempotent": true,
      "supportsDryRun": true,
      "supportsResultJson": true,
      "params": [
        {
          "name": "branch",
          "type": "string",
          "required": true,
          "label": "分支"
        },
        {
          "name": "holdId",
          "type": "string",
          "required": true,
          "label": "持有者 ID",
          "description": "调用方自定的稳定标识，如 osglauncher:<项目>；同一 ID 重复保护只刷新时间"
        },
        {
          "name": "expectedPath",
          "type": "string",
          "required": true,
          "label": "确认的目录",
          "description": "调用方看到的工作副本实际目录（绝对路径）；与池里不一致时拒绝，避免保护错槽位"
        },
        {
          "name": "label",
          "type": "string",
          "label": "说明",
          "description": "给人看的持有者说明，如 OSGLauncher 开工"
        }
      ]
    },
    {
      "id": "unhold",
      "displayName": "解除保护",
      "description": "解除指定 holdId 的保护，其他持有者不受影响；须确认用到该工作副本的应用已关闭，可顺带释放租约",
      "kind": "action",
      "idempotent": true,
      "supportsDryRun": true,
      "supportsResultJson": true,
      "params": [
        {
          "name": "branch",
          "type": "string",
          "required": true,
          "label": "分支"
        },
        {
          "name": "holdId",
          "type": "string",
          "required": true,
          "label": "持有者 ID",
          "description": "与 hold 时逐字一致"
        },
        {
          "name": "confirmClosed",
          "type": "boolean",
          "default": false,
          "label": "已关闭相关应用",
          "description": "必须为 true：确认 IDE、编辑器等用到该目录的应用已关闭"
        },
        {
          "name": "releaseLease",
          "type": "boolean",
          "default": false,
          "label": "同时释放租约",
          "description": "等同再调用一次 release"
        }
      ]
    },
    {
      "id": "gc",
      "displayName": "池回收",
      "description": "推进中断恢复、校正池外改动（被切走的分支、已删的目录）、复查阻塞槽位、缩容删除多出的空闲槽位、清理失效入口与过期存档",
      "kind": "action",
      "idempotent": true,
      "supportsDryRun": true,
      "supportsResultJson": true
    },
    {
      "id": "refresh",
      "displayName": "更新工程",
      "description": "工程清单（projects）里已挂在槽位上的分支更新到最新；没挂槽的跳过，不为它们抢槽位",
      "kind": "action",
      "idempotent": true,
      "supportsDryRun": true,
      "supportsResultJson": true
    },
    {
      "id": "capture-sparse",
      "displayName": "导出稀疏配置",
      "description": "读取现有工作副本各目录的 depth，导出可贴进 pool.toml 的最小 [sparse] 配置；只读，不需要 pool.toml",
      "kind": "action",
      "idempotent": true,
      "supportsDryRun": true,
      "supportsResultJson": true,
      "params": [
        {
          "name": "path",
          "type": "string",
          "required": true,
          "label": "工作副本",
          "description": "现有工作副本目录，相对路径按 cwd 解析"
        }
      ]
    }
  ]
}
